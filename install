#!/usr/bin/env bash
set -euo pipefail
# set -x

# EX: ./install -w

OS="$(uname)"
WORK=false

##
## Install tools
##
install_helix() {
  if command -v hx > /dev/null 2>&1; then return; fi
  if [[ "${OS}" == "Darwin" ]]; then
    brew install helix
  elif [[ "${OS}" == "Linux" ]]; then
    local arch os

    arch=$(uname -m)
    os=linux
    mkdir -p "${HOME}/.local/bin"

    download_url=$(curl -fsSL https://api.github.com/repos/helix-editor/helix/releases/latest | \
      jq -r --arg arch "${arch}" --arg os "${os}" '.assets[] | select(.browser_download_url | contains($arch) and contains($os)) | .browser_download_url')
    release=$(curl -fsSL https://api.github.com/repos/helix-editor/helix/releases/latest | jq -r '.name')
    curl -sL "${download_url}" -o /tmp/helix.tar.xz
    tar xf /tmp/helix.tar.xz -C /tmp/
    mv "/tmp/helix-${release}-${arch}-${os}/hx" "${HOME}/.local/bin/hx"
    rm -rf /tmp/helix.tar.xz /tmp/helix
  fi

  # TODO: Install dependency npm
  # Language Server Protocol (LSP) support for Helix
  # # Ansible
  # npm i -g @ansible/ansible-language-server

  # # Bash
  # npm i -g bash-language-server

  # # Docker
  # npm install -g dockerfile-language-server-nodejs
  # npm install -g @microsoft/compose-language-service

  # # Json
  # npm i -g vscode-langservers-extracted

  # # SQL
  # npm i -g sql-language-server

  # # Terraform
  # https://github.com/helix-editor/helix/wiki/Language-Server-Configurations#terraform
  # brew install hashicorp/tap/terraform-ls

  # # TOML
  # https://github.com/helix-editor/helix/wiki/Language-Server-Configurations#terraform
  # brew install taplo
}

install_neovim() {
  if command -v nvim > /dev/null 2>&1; then return; fi

  if [[ "${OS}" == "Darwin" ]]; then
    brew install neovim
  elif [[ "${OS}" == "Linux" ]]; then
    sudo apt-get update -y > /dev/null
    sudo apt-get install -y neovim > /dev/null
  fi
}

install_oh_my_zsh() {
  if ! [[ -d "${HOME}/.oh-my-zsh" ]]; then
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended  > /dev/null

    # Remove oh-my-zsh's .zshrc
    rm -f "${HOME}/.zshrc"
  fi
}

install_starship() {
  if command -v starship > /dev/null 2>&1; then return; fi

  if [[ "${OS}" == "Darwin" ]]; then
    brew install starship
  elif [[ "${OS}" == "Linux" ]]; then
    sudo apt-get update -y > /dev/null
    sudo apt-get install -y starship > /dev/null
  fi
}

install_vim() {
  if ! [[  -d "${HOME}/.vim/bundle/Vundle.vim" ]]; then
    git clone --quiet https://github.com/VundleVim/Vundle.vim.git ~/.vim/bundle/Vundle.vim
  fi

  mkdir -p "${HOME}"/.vim/colors
  vim --clean '+source ~/.vimrc' +PluginInstall +qall

  # shellcheck disable=SC2144
  if [[ -f "${HOME}"/.vim/bundle/vim-colorschemes/colors/* ]]; then
   mv "${HOME}"/.vim/bundle/vim-colorschemes/colors/* \
    "${HOME}"/.vim/colors
  fi

  # shellcheck disable=SC2144
  if [[ -f "${HOME}"/.vim/bundle/vim-railscasts-theme/colors/* ]]; then
    mv "${HOME}"/.vim/bundle/vim-railscasts-theme/colors/* \
      "${HOME}"/.vim/colors
  fi
}

# TODO: remove this
sym_link() {
  echo "ln -s \"${1}\" \"${2}\""
  ln -s "${1}" "${2}"
}

check_sym_link() {
  if ! [[ -e ${2} ]]; then
    sym_link "${1}" "${2}"
  elif [[ -L ${2} ]];then
    echo "linked:skipped: ${2}"
  else
    echo "not-linked:exists:skipped: rm -rf ${2}"
  fi
}

##
## Setup configs
##
setup_configs() {
  local config_json
  config_json="$(yq -o=json config.yaml)"
  mkdir -p "${HOME}/.config"
  for key in $(echo "${config_json}" | jq -r 'keys[]'); do
    local source target
    source="$(echo "${config_json}" | jq -r --arg k "${key}" '.[$k].source')"
    target="$(echo "${config_json}" | jq -r --arg k "${key}" '.[$k].target')"
    check_sym_link "$(pwd)/${source}" "${HOME}/${target}"
  done

}

setup_configs_work() {
  echo "TBD setup configs for work"
}

##
## Main
##
options() {
  while getopts ":w" opt; do
    case "${opt}" in
      w)
        WORK=true;;
      *)
        usage;;
    esac
  done
}

main() {
  options "$@"
  install_helix
  install_neovim
  install_oh_my_zsh
  install_starship
  install_vim
  setup_configs
  # setup_configs_work

  if $WORK; then
    # shellcheck disable=SC2016
    grep -qxF 'export PATH="$HOME/bin-work:$PATH"' conf/zshrc || echo 'export PATH="$HOME/bin-work:$PATH"' >> conf/zshrc
    grep -qxF 'source ~/.zshrc-work' conf/zshrc || echo 'source ~/.zshrc-work' >> conf/zshrc
  fi
  # Only reload zshrc in interactive sessions (skipped in Docker/CI)
  # shellcheck disable=SC1090
  [[ $- == *i* ]] && source ~/.zshrc || true
}

usage() {
  echo "Usage: $(basename "${0}") [-w]"
  echo "  -w: Is this a work machine?"
  exit 1
}

# Only execute when this script is run directly, not when sourced
# (e.g. by the unit tests that need access to the helper functions).
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
else
  # Avoid leaking strict-mode options into the caller when sourced (e.g. bats).
  set +e +u +o pipefail
fi
