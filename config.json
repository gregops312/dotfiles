  },
  "gitconfig": {
    "source": "conf/gitconfig",
    "target": ".gitconfig"
  },
  "gitconfig-personal": {
    "source": "conf/gitconfig-personal",
    "target": ".gitconfig-personal"
  },
  "gitconfig-work": {
    "source": "conf/gitconfig-work",
    "target": ".gitconfig-work"
  },
